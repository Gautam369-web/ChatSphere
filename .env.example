# Environment Configuration for ChatSphere

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chatsphere?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="chatsphere_super_secret_jwt_and_session_key_2026_change_me_in_production"

# Google OAuth (Optional / Production)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Redis (Presence, Typing, Socket.io Adapter)
REDIS_URL="redis://localhost:6379"

# Socket.IO Server URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
SOCKET_PORT=3001
PORT=3000

# Cloudinary / File Storage (Optional)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Firebase Cloud Messaging (FCM)
NEXT_PUBLIC_FIREBASE_API_KEY="your_firebase_api_key"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_firebase_project_id"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
FIREBASE_SERVICE_ACCOUNT_KEY="{}"

# SendGrid / SMTP Email
SENDGRID_API_KEY="your_sendgrid_api_key"
EMAIL_FROM="noreply@chatsphere.io"
